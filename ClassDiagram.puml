@startuml ClassDiagram
skinparam classAttributeIconSize 0

class DateTime {
    - second: int
    - minute: int
    - hour: int
    - day: int
    - month: int
    - year: int
    + DateTime()
    + DateTime(second: int, minute: int, hour: int, day: int, month: int, year: int)
    + {static} getCurrentTime(): DateTime
    + operator<(other: DateTime): bool
    + toString(): string
}

class Book {
    - isbn: string
    - title: string
    - author: string
    - language: string
    - publishedYear: int
    - price: double
    - stockLevel: int
    - inputDate: DateTime
    + Book(isbn: string, title: string, author: string, language: string, publishedYear: int, price: double, stockLevel: int, inputDate: DateTime)
    + getIsbn(): string
    + getTitle(): string
    + getAuthor(): string
    + getLanguage(): string
    + getPublishedYear(): int
    + getPrice(): double
    + getStockLevel(): int
    + getInputDate(): DateTime
    + setStockLevel(stock: int): void
    + setInputDate(date: DateTime): void
    + display(): void
    + toString(): string
}

struct CartItem {
    + book: Book
    + quantity: int
}

class BookStore {
    - name: string
    - data: vector<Book>
    + BookStore(name: string)
    + loadFromFile(filename: string): bool
    + saveToFile(filename: string): void
    + displaySortedByPrice(): void
    + displayTopKLatest(ka: int): void
    + importBook(): void
    + addToCart(cart: vector<CartItem>&): void
    + checkout(cart: vector<CartItem>&, orderFilename: string): void
    + displayLowStock(kb: int): void
}

' Mối quan hệ giữa các lớp
Book "1" *-- "1" DateTime : contains >
BookStore "1" o-- "*" Book : manages >
CartItem "1" o-- "1" Book : references >
BookStore ..> CartItem : uses >

@enduml